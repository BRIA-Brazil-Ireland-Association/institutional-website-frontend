{
	"mcpServers": {
		"context7": {
			"command": "npx",
			"args": ["-y", "@upstash/context7-mcp"]
		},
		"tailwindcss-server": {
			"command": "npx",
			"args": ["-y", "tailwindcss-mcp-server"]
		},
		"next-devtools": {
			"command": "npx",
			"args": ["-y", "next-devtools-mcp@latest"]
		}
	},
	"enabledPlugins": {
		"vercel-react-best-practices@claude-code-marketplace": true,
		"security-review@claude-code-marketplace": true
	}
}
